@model LojaMvcDapper.Models.Produto

@{
    ViewData["Title"] = "Excluir Produto";
}

<!-- =========================================================================
     TELA 5: CONFIRMAÇÃO DE EXCLUSÃO (DELETE)
     Demonstração de exclusão segura: tela GET de confirmação antes de executar o POST
     ========================================================================= -->

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-sm border-0 border-top border-danger border-4">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold text-danger">⚠️ Confirmação de Exclusão</h4>
                <small class="text-muted">Esta ação removerá o registro do banco de dados definitivamente.</small>
            </div>
            <div class="card-body p-4 bg-white">
                <div class="alert alert-danger" role="alert">
                    Você tem certeza de que deseja excluir o produto abaixo?
                </div>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">ID:</dt>
                    <dd class="col-sm-8 fw-bold">#@Model.Id</dd>

                    <dt class="col-sm-4 text-muted">Nome:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Nome</dd>

                    <dt class="col-sm-4 text-muted">Categoria:</dt>
                    <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Categoria</span></dd>

                    <dt class="col-sm-4 text-muted">Preço:</dt>
                    <dd class="col-sm-8 text-success fw-bold">R$ @Model.Preco.ToString("N2")</dd>

                    <dt class="col-sm-4 text-muted">Estoque:</dt>
                    <dd class="col-sm-8">@Model.Estoque unidades</dd>
                </dl>

                <form asp-action="Excluir" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            &larr; Cancelar e Voltar
                        </a>
                        <button type="submit" class="btn btn-danger px-4">
                            🗑️ Confirmar Exclusão
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
