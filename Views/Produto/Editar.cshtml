@model LojaMvcDapper.Models.Produto

@{
    ViewData["Title"] = "Editar Produto";
}

<!-- =========================================================================
     TELA 4: EDIÇÃO DE PRODUTO EXISTENTE
     Demonstração de atualização com Dapper, campos pré-carregados e hidden ID
     ========================================================================= -->

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="mb-0 fw-bold">✏️ Editar Produto #@Model.Id</h4>
                <small>Atualize as informações do item e clique em salvar para persistir no SQLite.</small>
            </div>
            <div class="card-body p-4 bg-white">
                <form asp-action="Editar" method="post">
                    <!-- Campo Oculto para repassar o Id no POST sem que o usuário modifique -->
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="DataCadastro" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- CAMPO: NOME -->
                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-semibold"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <!-- CAMPO: CATEGORIA -->
                    <div class="mb-3">
                        <label asp-for="Categoria" class="form-label fw-semibold"></label>
                        <input asp-for="Categoria" class="form-control" />
                        <span asp-validation-for="Categoria" class="text-danger small"></span>
                    </div>

                    <!-- LINHA COM PREÇO E ESTOQUE -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Preco" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="Preco" type="number" step="0.01" class="form-control" />
                            </div>
                            <span asp-validation-for="Preco" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Estoque" class="form-label fw-semibold"></label>
                            <input asp-for="Estoque" type="number" class="form-control" />
                            <span asp-validation-for="Estoque" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- BOTÕES DE SUBMISSÃO E CANCELAMENTO -->
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            &larr; Cancelar e Voltar
                        </a>
                        <button type="submit" class="btn btn-warning px-4 fw-bold">
                            💾 Atualizar Alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
