@model LojaMvcDapper.Models.Produto

@{
    ViewData["Title"] = "Cadastrar Novo Produto";
}

<!-- =========================================================================
     TELA DE CADASTRO DE PRODUTO
     Demonstração de formulário com Tag Helpers, Validação Dupla (Client/Server)
     e prevenção CSRF com token automático.
     ========================================================================= -->

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold">➕ Cadastrar Novo Produto</h4>
                <small class="text-white-50">Preencha os campos abaixo para registrar o item no banco de dados.</small>
            </div>
            <div class="card-body p-4 bg-white">
                <form asp-action="Criar" method="post">
                    <!-- Sumário geral de validação: Exibe mensagens de regras de negócio caso existam -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- CAMPO: NOME -->
                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-semibold"></label>
                        <input asp-for="Nome" class="form-control" placeholder="Ex: Monitor UltraWide 29 IPS" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <!-- CAMPO: CATEGORIA -->
                    <div class="mb-3">
                        <label asp-for="Categoria" class="form-label fw-semibold"></label>
                        <input asp-for="Categoria" class="form-control" placeholder="Ex: Monitores, Periféricos, Hardware..." />
                        <span asp-validation-for="Categoria" class="text-danger small"></span>
                    </div>

                    <!-- LINHA COM PREÇO E ESTOQUE -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Preco" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="Preco" type="number" step="0.01" class="form-control" placeholder="0,00" />
                            </div>
                            <span asp-validation-for="Preco" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Estoque" class="form-label fw-semibold"></label>
                            <input asp-for="Estoque" type="number" class="form-control" placeholder="Ex: 10" />
                            <span asp-validation-for="Estoque" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- BOTÕES DE SUBMISSÃO E CANCELAMENTO -->
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            &larr; Voltar para o Catálogo
                        </a>
                        <button type="submit" class="btn btn-success px-4">
                            💾 Salvar Produto
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     SCRIPTS DE VALIDAÇÃO CLIENT-SIDE (JQUERY UNOBTRUSIVE)
     Valida campos no próprio navegador sem disparar requisições ao servidor
     ========================================================================= -->
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
